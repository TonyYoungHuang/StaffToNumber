# Compose interpolation settings; merge into project .env for a future authorized release.
# Keep RATE_LIMIT_ENABLED=true in private runtime.env for security policies.
UPLOAD_MALWARE_SCAN=off
JOB_BROKER_CONCURRENCY=3
MUSIC_ENGINE_MAX_CONCURRENCY=3
MUSIC_ENGINE_HOMR_SLOT_WEIGHT=3
MUSIC_ENGINE_AUDIO_SLOT_WEIGHT=3
WORKER_PROCESSING_DELAY_MS=0
SCORE_PREFLIGHT_MAX_CONCURRENCY=3
SCORE_PREFLIGHT_QUEUE_WAIT_MS=120000
SCORE_PREFLIGHT_TIMEOUT_MS=60000
SCORE_PREFLIGHT_REQUESTS_PER_MINUTE=0
RATE_LIMIT_MAX=0
API_CPU_LIMIT=2.0
WORKER_CPU_LIMIT=2.0
API_MEMORY_LIMIT=1792m
WORKER_MEMORY_LIMIT=2560m
WORKER_MEMORY_SWAP_LIMIT=3g
WORKER_PIDS_LIMIT=512
WWW_MEMORY_LIMIT=512m
