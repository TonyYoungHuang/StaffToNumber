ARG BACKEND_IMAGE
FROM ${BACKEND_IMAGE}
USER root
ARG AUDIVERIS_VERSION=5.10.2
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl fluidsynth fluid-soundfont-gm fonts-dejavu-core imagemagick \
    libsndfile1 libxtst6 musescore3 openjdk-17-jre-headless tesseract-ocr unzip && \
    rm -rf /var/lib/apt/lists/*
RUN mkdir -p /opt/audiveris/tessdata && \
    curl -fsSL https://raw.githubusercontent.com/tesseract-ocr/tessdata/4.1.0/eng.traineddata -o /opt/audiveris/tessdata/eng.traineddata && \
    echo 'daa0c97d651c19fba3b25e81317cd697e9908c8208090c94c3905381c23fc047  /opt/audiveris/tessdata/eng.traineddata' | sha256sum -c -
ENV TESSDATA_PREFIX=/opt/audiveris/tessdata
RUN curl -fsSL -o /tmp/audiveris.deb \
      "https://github.com/Audiveris/audiveris/releases/download/${AUDIVERIS_VERSION}/Audiveris-${AUDIVERIS_VERSION}-ubuntu22.04-x86_64.deb" && \
    dpkg --unpack /tmp/audiveris.deb && \
    sed -i '/^xdg-desktop-menu /d; /^xdg-mime /d' /var/lib/dpkg/info/audiveris.postinst && \
    dpkg --configure audiveris && \
    test -f /opt/audiveris/lib/app/Audiveris.cfg && \
    grep -Eiq '^java-options=-Xmx[0-9]+[gmk]$' /opt/audiveris/lib/app/Audiveris.cfg && \
    sed -Ei '/^java-options=-Xmx[0-9]+[gmk]$/Id' /opt/audiveris/lib/app/Audiveris.cfg && \
    ! grep -Eiq '^java-options=-Xmx' /opt/audiveris/lib/app/Audiveris.cfg && \
    rm -f /tmp/audiveris.deb
RUN /opt/score-python/bin/pip install --no-cache-dir "setuptools<81" basic-pitch==0.4.0 yt-dlp && \
    /opt/score-python/bin/python -m pip check
COPY deploy/backend/soundfont-license-manifest.json deploy/backend/soundfont-license-manifest.json
COPY deploy/backend/licenses deploy/backend/licenses
ENV AUDIVERIS_COMMAND=/opt/audiveris/bin/Audiveris AUDIVERIS_MAX_HEAP_MB=768 \
    AUDIVERIS_IMAGE_MAGICK_COMMAND=/usr/bin/convert BASIC_PITCH_COMMAND=/opt/score-python/bin/basic-pitch \
    YT_DLP_COMMAND=/opt/score-python/bin/yt-dlp FLUIDSYNTH_COMMAND=/usr/bin/fluidsynth \
    SOUNDFONT_PATH=/usr/share/sounds/sf2/FluidR3_GM.sf2 \
    SOUNDFONT_LICENSE_MANIFEST=/srv/scoretransposer/deploy/backend/soundfont-license-manifest.json \
    MUSESCORE_COMMAND=/usr/bin/musescore3 QT_QPA_PLATFORM=offscreen
USER node
CMD ["node", "services/worker/dist/index.js"]
