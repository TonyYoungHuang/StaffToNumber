# Fill these ONLY in /srv/sites/scoretransposer/shared/runtime.env after Live onboarding.
# This template contains no credentials and does not enable Stripe by itself.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_CONVERTER_PRO_MONTHLY_PRICE_ID=
STRIPE_CONVERTER_PRO_ANNUAL_PRICE_ID=
STRIPE_ACCOUNT_COUNTRY=HK
STRIPE_MANAGED_PAYMENTS_ENABLED=false
PAYMENT_BILLING_MODE=subscription
PUBLIC_SITE_URL=https://scoretransposer.com
PUBLIC_APP_URL=https://app.scoretransposer.com
PUBLIC_API_URL=https://api.scoretransposer.com

# After the production preflight and end-to-end acceptance pass, add stripe to
# the existing PAYMENT_PROVIDERS and NEXT_PUBLIC_LIVE_PAYMENT_PROVIDERS lists.
# Preserve any existing Paddle configuration. Rebuild both frontend images for
# a NEXT_PUBLIC_* change. Never place the server key or webhook secret there.
# Non-recurring prices for one calendar month / one calendar year.
STRIPE_STARTER_MONTHLY_ONE_TIME_PRICE_ID=
STRIPE_STARTER_ANNUAL_ONE_TIME_PRICE_ID=
STRIPE_CONVERTER_PRO_MONTHLY_ONE_TIME_PRICE_ID=
STRIPE_CONVERTER_PRO_ANNUAL_ONE_TIME_PRICE_ID=

# One Score Pass: active Live USD 2.99 one-time Price (not a subscription).
# Set the Price ID in private runtime.env; see predeploy-gaps-2026-10-09.md.
STRIPE_SINGLE_SCORE_PRICE_ID=
