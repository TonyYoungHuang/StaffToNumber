FROM node:22-bookworm-slim

WORKDIR /srv/scoretransposer

ENV PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PATH=/opt/score-python/bin:$PATH

RUN set -eux; \
    apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 update; \
    for attempt in 1 2 3; do \
      if apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 install -y --no-install-recommends \
        ca-certificates \
        clamav \
        clamav-freshclam \
        ffmpeg \
        python3 \
        python3-venv \
        util-linux; then \
        break; \
      fi; \
      test "$attempt" -lt 3; \
      sleep "$((attempt * 10))"; \
      apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 update; \
    done; \
    for attempt in 1 2 3; do \
      if freshclam --stdout; then break; fi; \
      test "$attempt" -lt 3; \
      sleep "$((attempt * 10))"; \
    done; \
    test "$(find /var/lib/clamav -maxdepth 1 -type f \( -name '*.cvd' -o -name '*.cld' \) | wc -l)" -gt 0 && \
    clamscan --version && \
    ffmpeg -version >/dev/null && \
    ffprobe -version >/dev/null && \
    rm -rf /var/lib/apt/lists/* /var/log/clamav/*

RUN python3 -m venv /opt/score-python && \
    /opt/score-python/bin/pip install --no-cache-dir "setuptools<81" music21==10.5.0 && \
    /opt/score-python/bin/python -c "import music21; print(music21.__version__)"

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/app/package.json apps/app/package.json
COPY apps/www/package.json apps/www/package.json
COPY packages/i18n/package.json packages/i18n/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/storage/package.json packages/storage/package.json
COPY packages/runtime-database/package.json packages/runtime-database/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY services/api/package.json services/api/package.json
COPY services/worker/package.json services/worker/package.json
COPY services/collaboration/package.json services/collaboration/package.json
COPY services/cloudflare-gateway/package.json services/cloudflare-gateway/package.json
RUN npm ci --ignore-scripts

COPY packages ./packages
COPY services/api ./services/api
RUN npm run build -w @score/i18n && npm run build -w @score/shared && npm run build -w @score/storage && npm run build -w @score/runtime-database && npm run build -w @score/api

ENV NODE_ENV=staging \
    HOST=0.0.0.0 \
    PORT=4000 \
    RUNTIME_DATABASE_PRIMARY=postgres \
    STORAGE_DIR=/tmp/scoretransposer/storage \
    CLAMAV_COMMAND=/usr/bin/clamscan \
    CLAMAV_REQUIRED=true \
    CLAMAV_TIMEOUT_MS=180000 \
    FFMPEG_COMMAND=/usr/bin/ffmpeg \
    FFPROBE_COMMAND=/usr/bin/ffprobe \
    MUSIC21_COMMAND=/opt/score-python/bin/python \
    MEDIA_SAFETY_REQUIRED=true

RUN mkdir -p /srv/scoretransposer/runtime /tmp/scoretransposer/storage && \
    chown -R node:node /srv/scoretransposer/runtime /tmp/scoretransposer
EXPOSE 4000
CMD ["node", "services/api/dist/index.js"]
