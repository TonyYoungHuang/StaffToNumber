FROM node:22-bookworm-slim

WORKDIR /srv/scoretransposer
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/app/package.json apps/app/package.json
COPY apps/www/package.json apps/www/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/storage/package.json packages/storage/package.json
COPY packages/runtime-database/package.json packages/runtime-database/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY services/api/package.json services/api/package.json
COPY services/worker/package.json services/worker/package.json
COPY services/collaboration/package.json services/collaboration/package.json
COPY services/cloudflare-gateway/package.json services/cloudflare-gateway/package.json
RUN npm ci --ignore-scripts

COPY packages/shared ./packages/shared
COPY packages/runtime-database ./packages/runtime-database
COPY services/collaboration ./services/collaboration
RUN npm run build -w @score/shared && npm run build -w @score/runtime-database && npm run build -w @score/collaboration

ENV NODE_ENV=staging \
    HOST=0.0.0.0 \
    COLLABORATION_PORT=4001 \
    RUNTIME_DATABASE_PRIMARY=postgres

RUN mkdir -p /srv/scoretransposer/runtime && chown -R node:node /srv/scoretransposer/runtime
USER node
EXPOSE 4001
CMD ["node", "services/collaboration/dist/index.js"]
