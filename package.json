{
  "name": "online-pdf-score-converter",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:www": "npm run dev -w @score/www",
    "dev:app": "npm run dev -w @score/app",
    "dev:api": "npm run dev -w @score/api",
    "dev:worker": "npm run dev -w @score/worker",
    "dev:collaboration": "npm run dev -w @score/collaboration",
    "cloudflare:preflight:staging": "node scripts/cloudflare-preflight.mjs --environment=staging",
    "cloudflare:preflight:production": "node scripts/cloudflare-preflight.mjs --environment=production --online",
    "cloudflare:bootstrap:staging": "node scripts/cloudflare-bootstrap.mjs --environment=staging",
    "cloudflare:build:frontends:staging": "node scripts/cloudflare-deploy-frontends.mjs --environment=staging --build-only",
    "cloudflare:deploy:frontends:staging": "node scripts/cloudflare-deploy-frontends.mjs --environment=staging",
    "cloudflare:build:frontends:production": "node scripts/cloudflare-deploy-frontends.mjs --environment=production --build-only --confirm-production=scoretransposer.com",
    "cloudflare:deploy:frontends:production": "node scripts/cloudflare-deploy-frontends.mjs --environment=production --confirm-production=scoretransposer.com",
    "cloudflare:deploy:staging": "node scripts/cloudflare-deploy.mjs --environment=staging",
    "cloudflare:deploy:production": "node scripts/cloudflare-deploy.mjs --environment=production --confirm-production=scoretransposer.com",
    "verify:postgres:runtime": "node scripts/verify-postgres-runtime.mjs",
    "repair:postgres:runtime-schema:staging": "powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/ensure-postgres-runtime-schema.ps1 -Environment staging -Verify",
    "repair:postgres:runtime-schema:production": "powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/ensure-postgres-runtime-schema.ps1 -Environment production -Verify",
    "repair:postgres:runtime-triggers:staging": "powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/ensure-postgres-runtime-triggers.ps1 -Environment staging -Verify",
    "repair:postgres:runtime-triggers:production": "powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/ensure-postgres-runtime-triggers.ps1 -Environment production -Verify",
    "verify:redis:runtime": "node scripts/verify-redis-runtime.mjs",
    "verify:staging:data-services": "powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/verify-staging-data-services.ps1",
    "verify:staging:data-services:full": "powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/verify-staging-data-services.ps1 -RunIntegrationTests",
    "verify:staging:core-score-e2e": "node scripts/run-deployed-core-score-e2e.mjs",
    "verify:production:backup-restore": "node scripts/run-production-backup-restore-drill.mjs",
    "generate:samples": "node samples/generate-fixtures.mjs",
    "generate:home-feature-videos": "node --import tsx scripts/generate-home-feature-videos.ts",
    "evaluate:samples": "npm run build -w @score/worker && npm run evaluate:samples -w @score/worker",
    "audit:encoding": "node scripts/audit-text-encoding.mjs",
    "audit:production-seo": "node scripts/audit-production-seo.mjs",
    "verify:production-config": "node scripts/verify-production-config.mjs",
    "lint": "npm run audit:encoding && node scripts/lint-repository.mjs",
    "build": "npm run build -w @score/shared && npm run build -w @score/ui && npm run build -w @score/storage && npm run build -w @score/runtime-database && npm run build -w @score/api && npm run build -w @score/worker && npm run build -w @score/collaboration && npm run typecheck -w @score/cloudflare-gateway && npm run build -w @score/www && npm run build -w @score/app",
    "build:test-deps": "npm run build -w @score/shared && npm run build -w @score/storage && npm run build -w @score/runtime-database",
    "test:unit": "npm run build:test-deps && npm run test -w @score/storage && npm run test -w @score/runtime-database && npm run test:unit -w @score/api && npm run test -w @score/worker && npm run test -w @score/www && npm run test -w @score/app",
    "test:integration": "npm run build:test-deps && npm run test:integration -w @score/storage && npm run test:postgres -w @score/api && npm run test:broker -w @score/api && npm run test:integration -w @score/api && npm run test -w @score/collaboration",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/omr-candidate-review.spec.ts --grep \"pixel-stable\"",
    "test:performance": "playwright test tests/e2e/omr-candidate-review.spec.ts --grep \"20,000-note\"",
    "test": "npm run audit:encoding && npm run test:unit && npm run test:integration",
    "typecheck": "npm run build -w @score/shared && npm run build -w @score/ui && npm run build -w @score/storage && npm run build -w @score/runtime-database && npm run typecheck -w @score/api && npm run typecheck -w @score/worker && npm run typecheck -w @score/collaboration && npm run typecheck -w @score/cloudflare-gateway && npm run typecheck -w @score/www && npm run typecheck -w @score/app",
    "security": "npm audit --audit-level=high",
    "qualify:music-engines": "node scripts/qualify-music-engines.mjs",
    "test:music-engines": "node scripts/run-real-music-engine-tests.mjs",
    "test:music-engines:host": "npm run qualify:music-engines && npm run test:music-engines -w @score/api && npm run test:music-engines -w @score/worker",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "release:verify": "node scripts/verify-release-manifest.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "rclone.js": {
      "adm-zip": "^0.6.0"
    }
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.55.1",
    "cheerio": "^1.1.2",
    "postcss": "^8.5.26",
    "wrangler": "^4.123.0"
  }
}
