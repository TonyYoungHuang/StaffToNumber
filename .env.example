NODE_ENV=development
# Free accounts receive one lifetime simple normal-lane scan, without monthly credits.
FREE_TRIAL_OMR_JOBS=1
QUOTA_FREE_JOBS_PER_MONTH=0
# Recognition lane admission and raster variants are enabled only in a later qualified release.
RECOGNITION_LANES_ENABLED=false
RASTER_ENHANCEMENT_ENABLED=false
RECOGNITION_NORMAL_MAX_MB=1536
RECOGNITION_BIG_MAX_MB=2048
RECOGNITION_BIG_HEAP_MB=768
RECOGNITION_CAPACITY_VERSION=cx33-conservative-v1
# API only: secret of the existing GOOGLE_CLIENT_ID (no new client required).
GOOGLE_CLIENT_SECRET=
UPLOAD_MALWARE_SCAN=off
SCORE_PREFLIGHT_MAX_CONCURRENCY=1
SCORE_PREFLIGHT_QUEUE_WAIT_MS=120000
SCORE_PREFLIGHT_TIMEOUT_MS=60000
SCORE_PREFLIGHT_REQUESTS_PER_MINUTE=0
RATE_LIMIT_MAX=0
# cx33-conservative: serial recognition is the code and compose default.
JOB_BROKER_CONCURRENCY=1
MUSIC_ENGINE_MAX_CONCURRENCY=1
MUSIC_ENGINE_HOMR_SLOT_WEIGHT=3
MUSIC_ENGINE_AUDIO_SLOT_WEIGHT=3
WORKER_PROCESSING_DELAY_MS=0

