      "Apache-2.0",
      "CC0-1.0",
      "CC-BY-3.0",
      "CC-BY-4.0",
      "MIT",
      "OFL-1.1"
    ],
    "licensesRequiringAttribution": ["CC-BY-3.0", "CC-BY-4.0"],
    "requireRedistributionAllowed": true,
    "requireSha256": true
  },
  "acousticGolden": {
    "sampleRate": 48000,
    "channels": 2,
    "tempoBpm": 120,
