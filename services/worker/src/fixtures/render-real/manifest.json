{
  "schemaVersion": 1,
  "fixture": "qualification.musicxml",
  "optInEnv": "RUN_SCORE_RENDERER_REAL_INTEGRATION",
  "environment": {
    "museScoreCommand": "MUSESCORE_COMMAND",
    "fluidSynthCommand": "FLUIDSYNTH_COMMAND",
    "ffmpegCommand": "FFMPEG_COMMAND",
    "soundFontPath": "SOUNDFONT_PATH",
    "soundFontLicenseManifest": "SOUNDFONT_LICENSE_MANIFEST"
  },
  "timeoutsMs": {
    "museScore": 120000,
    "fluidSynth": 120000,
    "ffmpeg": 120000,
    "forcedFailure": 1
  },
