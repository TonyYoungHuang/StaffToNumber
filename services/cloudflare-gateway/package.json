{
  "name": "@score/cloudflare-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/request-proxy.test.ts",
    "deploy:staging": "wrangler deploy --config ../../deploy/cloudflare/wrangler.staging.jsonc",
    "deploy:production": "wrangler deploy --config ../../deploy/cloudflare/wrangler.production.jsonc",
    "types:staging": "wrangler types --config ../../deploy/cloudflare/wrangler.staging.jsonc worker-configuration.d.ts"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "typescript": "5.8.3",
    "wrangler": "^4.120.1"
  }
}
